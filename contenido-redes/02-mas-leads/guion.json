{
  "titulo": "Más leads",
  "nota": "Cada fragmento es un subtítulo. 'pausa' marca el hueco después del fragmento (x0,35 al montar la toma).",
  "fragmentos": [
    {"n": 1,  "escena": 1,  "texto": "Más leads…", "pausa": 0.3},
    {"n": 2,  "escena": 1,  "texto": "no te hace vender más.", "pausa": 0.6},
    {"n": 3,  "escena": 2,  "texto": "Doblas el presupuesto en anuncios:", "pausa": 0.2},
    {"n": 4,  "escena": 2,  "texto": "doscientos contactos al mes en vez de cien.", "pausa": 0.4},
    {"n": 5,  "escena": 3,  "texto": "Y las visitas a la sala de ventas…", "pausa": 0.3},
    {"n": 6,  "escena": 3,  "texto": "casi no se mueven.", "pausa": 0.6},
    {"n": 7,  "escena": 4,  "texto": "Porque tu embudo tiene agujeros.", "pausa": 0.4},
    {"n": 8,  "escena": 4,  "texto": "Cada pregunta que el plano no contesta es uno.", "pausa": 0.3},
    {"n": 9,  "escena": 5,  "texto": "¿Le da el sol a la terraza?", "pausa": 0.15},
    {"n": 10, "escena": 5,  "texto": "¿Cabe mi cama?", "pausa": 0.15},
    {"n": 11, "escena": 5,  "texto": "¿Cómo es el baño?", "pausa": 0.15},
    {"n": 12, "escena": 5,  "texto": "¿Cómo queda el jardín?", "pausa": 0.5},
    {"n": 13, "escena": 6,  "texto": "Por cada agujero se va un comprador.", "pausa": 0.3},
    {"n": 14, "escena": 6,  "texto": "No te dice que no.", "pausa": 0.2},
    {"n": 15, "escena": 6,  "texto": "Deja de contestar.", "pausa": 0.6},
    {"n": 16, "escena": 7,  "texto": "Más anuncios llenan antes el embudo.", "pausa": 0.2},
    {"n": 17, "escena": 7,  "texto": "Pero se vacía por los mismos agujeros.", "pausa": 0.5},
    {"n": 18, "escena": 8,  "texto": "Hay que taparlos.", "pausa": 0.5},
    {"n": 19, "escena": 9,  "texto": "El sol, en cada terraza.", "pausa": 0.15},
    {"n": 20, "escena": 9,  "texto": "La cama, en cada dormitorio.", "pausa": 0.15},
    {"n": 21, "escena": 9,  "texto": "El baño, por dentro.", "pausa": 0.15},
    {"n": 22, "escena": 9,  "texto": "El jardín, con su piscina.", "pausa": 0.5},
    {"n": 23, "escena": 10, "texto": "El comprador ya no pregunta.", "pausa": 0.2},
    {"n": 24, "escena": 10, "texto": "Llega a la visita sabiendo qué casa quiere.", "pausa": 0.6},
    {"n": 25, "escena": 11, "texto": "Las reservas no salen de lo que echas arriba.", "pausa": 0.3},
    {"n": 26, "escena": 11, "texto": "Salen de lo que se queda dentro.", "pausa": 0.7},
    {"n": 27, "escena": 12, "texto": "Mándame el plano.", "pausa": 0.3},
    {"n": 28, "escena": 12, "texto": "Te enseño la casa.", "pausa": 2.0}
  ]
}
